    <path
        android:pathData="M54,22 L58.5,32 L58.5,62 L49.5,62 L49.5,32 Z"
        android:fillColor="#FFFFFFFF"/>
    <!-- Crossguard wings. -->
    <path
        android:pathData="M37,63 L71,63 L66.5,69 L57.5,66.5 L50.5,66.5 L41.5,69 Z"
        android:fillColor="#FFFFFFFF"/>
    <!-- Grip. -->
    <path
        android:pathData="M51.4,70 L56.6,70 L56.2,82 L51.8,82 Z"
        android:fillColor="#FFFFFFFF"/>
    <!-- Pommel. -->
    <path
        android:pathData="M54,84.4m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0"
        android:fillColor="#FFFFFFFF"/>
